<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>EgyptId</AssemblyName>
    <RootNamespace>EgyptId</RootNamespace>
    <Version>1.1.0</Version>
    <PackageId>EgyptId.Net</PackageId>
    <Authors>Eslam Ashraf</Authors>
    <Description>Egyptian national ID validation &amp; parsing, Egyptian phone number utilities, and Arabic text normalization for .NET.</Description>
    <PackageTags>egypt;national-id;phone;arabic;validation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SENESO/EgyptId.Net</RepositoryUrl>
      <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/SENESO/EgyptId.Net</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.1.0: new EgyptianPhone.FormatLocal; Benha (013) landlines now recognized by IsValidLandline/GetAreaName/GetPhoneType; wider Arabic diacritic stripping; invariant-culture national-ID date parsing.</PackageReleaseNotes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="../../docs/icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
